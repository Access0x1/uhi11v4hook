# ── Foundry build output: regenerated by `make gate`, never reviewed ──
lib/
out/
# forge writes keyed RPC URLs into cache/ during scripts
cache/
foundry-out/
.gas-snapshot
.forge-snapshots/
lcov.info
coverage/
report/

# ── Run records: every broadcast/ file carries your address, nonces and RPC ──
# Commit a deployment's record on purpose only (git add -f), after reading it.
broadcast/

# ── Secrets: none belong in this repo, ever. Keys live in `cast wallet` ──
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.keystore
keystore/
keystores/
secrets/
*.secret
# local anvil state can hold funded dev keys
.anvil/

# ── Fork rehearsals and scratch: local, short-lived, often name a chain or wallet ──
.rehearsal/
scratch/
tmp/
*.tmp
*.bak
*.orig
*.rej

# ── Notes, transcripts and drafts that are about you, not the hook ──
notes/
transcripts/
private-drafts/
*.private.md

# ── The AI harness: .claude/ IS committed (the no-attribution guard ships with every clone).
# Only the per-machine file is ignored: it lists the folders a session was granted.
**/.claude/settings.local.json
**/.claude/projects/
**/.claude/todos/

# ── OS and editor ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
*.log
node_modules/
